{
    "name": "ernestdefoe/shutter",
    "description": "Photo contests for Flarum 2: staff run themed contests on a schedule, members submit photos, the community votes or judges score, and winners are crowned on a podium with notifications and badges. A contest is a discussion.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "photo contest",
        "photography",
        "gallery",
        "voting",
        "competition"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/shutter",
    "support": {
        "issues": "https://github.com/ernestdefoe/shutter/issues",
        "source": "https://github.com/ernestdefoe/shutter"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.1"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Shutter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Shutter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Shutter",
            "category": "feature",
            "icon": {
                "name": "fas fa-camera-retro",
                "backgroundColor": "#b45309",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof/badges"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "flarum/tags": "^2.0",
        "fof/badges": "^2.0",
        "laravel/pint": "^1.32"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "style": "pint --test",
        "style:fix": "pint"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis",
        "style": "Checks the code style",
        "style:fix": "Fixes the code style"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
